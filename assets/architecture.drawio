        <mxCell id="idc" value="IAM Identity Center&lt;br&gt;approver sign-in (MFA)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.single_sign_on;" vertex="1" parent="1">
          <mxGeometry x="615" y="640" width="60" height="60" as="geometry" />
        </mxCell>

        
        <mxCell id="cloudwatch" value="CloudWatch Logs&lt;br&gt;decision log" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1">
          <mxGeometry x="870" y="640" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="firehose" value="Kinesis Data Firehose&lt;br&gt;log delivery" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.kinesis_data_firehose;" vertex="1" parent="1">
          <mxGeometry x="1110" y="640" width="60" height="60" as="geometry" />
        </mxCell>

        
        <mxCell id="market" value="Market price API&lt;br&gt;(external)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F8FA;strokeColor=#8C959F;dashed=1;fontColor=#24292F;" vertex="1" parent="1">
          <mxGeometry x="20" y="340" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="human" value="Human approver" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;" vertex="1" parent="1">
          <mxGeometry x="66" y="646" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="payment" value="Payment processor&lt;br&gt;+ merchants&lt;br&gt;(external)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F8FA;strokeColor=#8C959F;dashed=1;fontColor=#24292F;" vertex="1" parent="1">
          <mxGeometry x="1340" y="115" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="splunk" value="Splunk SIEM&lt;br&gt;(HTTP Event Collector)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F8FA;strokeColor=#8C959F;dashed=1;fontColor=#24292F;" vertex="1" parent="1">
          <mxGeometry x="1340" y="640" width="150" height="60" as="geometry" />
        </mxCell>

        
        <mxCell id="e1" value="1. trigger" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="eventbridge" target="lambda">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="2. read stock levels" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="lambda" target="rds">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="3. current price" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.8;exitDx=0;exitDy=0;" edge="1" parent="1" source="lambda" target="market">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="4. purchase intent" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="lambda" target="sqs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="5. pull intent" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sqs" target="gate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="load policy" style="html=1;endArrow=block;endFill=1;strokeColor=#7AA116;fontSize=11;labelBackgroundColor=#ffffff;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="thisrepo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="get credential&lt;br&gt;(APPROVED only)" style="html=1;endArrow=block;endFill=1;strokeColor=#DD344C;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="thisrepo" target="secrets">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="6a. APPROVED: pay merchant" style="html=1;endArrow=block;endFill=1;strokeColor=#2EA44F;strokeWidth=2;fontSize=11;fontColor=#1A7F37;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gate" target="payment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="6b. NEEDS APPROVAL" style="html=1;endArrow=block;endFill=1;strokeColor=#D29922;strokeWidth=2;fontSize=11;fontColor=#9A6700;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;exitDx=0;exitDy=0;" edge="1" parent="1" source="thisrepo" target="stepfn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="sign in" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="human" target="idc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="approve / reject" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="idc" target="stepfn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        
        <mxCell id="e12" value="7. every decision + reason&lt;br&gt;(including BLOCKED)" style="html=1;endArrow=block;endFill=1;strokeColor=#8250DF;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="thisrepo" target="cloudwatch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="stream" style="html=1;endArrow=block;endFill=1;strokeColor=#8250DF;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cloudwatch" target="firehose">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" value="8. alerts + search" style="html=1;endArrow=block;endFill=1;strokeColor=#8250DF;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="firehose" target="splunk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        
        <mxCell id="note" value="Reference architecture: how the gate would run in production on AWS. The Spend Gate decision logic (guard.py) is built in this repo; the AWS services around it show the environment it is designed for. The agent's IAM role can only send to the queue, so the only path from the agent to the money is through the gate." style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#57606A;" vertex="1" parent="1">
          <mxGeometry x="200" y="795" width="1110" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>