<mxfile host="app.diagrams.net">
  <diagram id="spend-gate-aws" name="Reference architecture (AWS)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="title" value="&lt;b&gt;AI Agent Spend Gate&lt;/b&gt;: reference architecture on AWS" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="200" y="-50" width="900" height="30" as="geometry" />
        </mxCell>

        <!-- AWS CLOUD -->
        <mxCell id="cloud" value="AWS Cloud" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="1330" height="820" as="geometry" />
        </mxCell>

        <!-- ZONES -->
        <mxCell id="agentzone" value="Agent zone (untrusted)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#CF222E;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#CF222E;" vertex="1" parent="1">
          <mxGeometry x="230" y="60" width="600" height="620" as="geometry" />
        </mxCell>
        <mxCell id="controlzone" value="Control zone: private subnet (trust boundary)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3FBF5;strokeColor=#2EA44F;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#1A7F37;" vertex="1" parent="1">
          <mxGeometry x="950" y="60" width="400" height="620" as="geometry" />
        </mxCell>

        <!-- BUILT IN THIS REPO (two boxes: agent + guardrail, and the gate) -->
        <mxCell id="thisrepo_agent" value="BUILT IN THIS REPO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAFBE1;strokeColor=#2EA44F;strokeWidth=2;verticalAlign=bottom;align=center;fontStyle=1;fontSize=10;fontColor=#1A7F37;arcSize=6;spacingBottom=4;" vertex="1" parent="1">
          <mxGeometry x="450" y="90" width="200" height="390" as="geometry" />
        </mxCell>
        <mxCell id="thisrepo" value="BUILT IN THIS REPO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAFBE1;strokeColor=#2EA44F;strokeWidth=2;verticalAlign=bottom;align=center;fontStyle=1;fontSize=10;fontColor=#1A7F37;arcSize=6;spacingBottom=4;" vertex="1" parent="1">
          <mxGeometry x="1030" y="90" width="200" height="200" as="geometry" />
        </mxCell>

        <!-- AGENT ZONE -->
        <mxCell id="eventbridge" value="EventBridge&lt;br&gt;schedule: every 15 min" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;" vertex="1" parent="1">
          <mxGeometry x="300" y="150" width="60" height="60" as="geometry" />
        </mxCell>
        <!-- Lambda's label sits ABOVE the icon so arrows can leave from its bottom -->
        <mxCell id="lambda" value="Lambda: &lt;b&gt;Strands agent&lt;/b&gt;&lt;br&gt;purchasing agent (agent.py)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=top;verticalAlign=bottom;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="520" y="150" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rds" value="RDS&lt;br&gt;inventory database" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;" vertex="1" parent="1">
          <mxGeometry x="300" y="340" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="decider" value="ECS on EC2 GPU&lt;br&gt;&lt;b&gt;Decider 2B guardrail&lt;/b&gt;&lt;br&gt;(strands-decider serve)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecs;" vertex="1" parent="1">
          <mxGeometry x="520" y="340" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bedrock" value="Amazon Bedrock&lt;br&gt;&lt;b&gt;Nova Lite&lt;/b&gt;&lt;br&gt;(via VPC endpoint)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1">
          <mxGeometry x="740" y="340" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- BETWEEN ZONES -->
        <mxCell id="sqs" value="SQS&lt;br&gt;purchase intents" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1">
          <mxGeometry x="860" y="150" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="stepfn" value="Step Functions&lt;br&gt;approval workflow" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.step_functions;" vertex="1" parent="1">
          <mxGeometry x="860" y="560" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="idc" value="IAM Identity Center&lt;br&gt;approver sign-in (MFA)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.single_sign_on;" vertex="1" parent="1">
          <mxGeometry x="860" y="730" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- CONTROL ZONE -->
        <mxCell id="gate" value="ECS Fargate&lt;br&gt;&lt;b&gt;Spend Gate&lt;/b&gt;&lt;br&gt;check_request()" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;" vertex="1" parent="1">
          <mxGeometry x="1100" y="150" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="S3&lt;br&gt;policy.json" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1">
          <mxGeometry x="1040" y="360" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="secrets" value="Secrets Manager&lt;br&gt;payment credential" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" vertex="1" parent="1">
          <mxGeometry x="1230" y="360" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="iam" value="IAM roles (least privilege)&lt;br&gt;agent: invoke Nova Lite + send to queue&lt;br&gt;gate: read policy + secret&lt;br&gt;Decider: no AWS permissions" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;" vertex="1" parent="1">
          <mxGeometry x="1230" y="500" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- LOGGING (bottom row) -->
        <mxCell id="cloudwatch" value="CloudWatch Logs&lt;br&gt;decisions + guardrail verdicts" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1">
          <mxGeometry x="1100" y="730" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="firehose" value="Kinesis Data Firehose&lt;br&gt;log delivery" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.kinesis_data_firehose;" vertex="1" parent="1">
          <mxGeometry x="1400" y="730" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- OUTSIDE AWS -->
        <mxCell id="market" value="Market prices +&lt;br&gt;supplier feed (external)&lt;br&gt;&lt;font color=&quot;#CF222E&quot;&gt;&lt;b&gt;untrusted: injection risk&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F8FA;strokeColor=#8C959F;dashed=1;fontColor=#24292F;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="10" y="330" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="human" value="Human approver" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;" vertex="1" parent="1">
          <mxGeometry x="66" y="736" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="payment" value="Payment processor&lt;br&gt;+ merchants&lt;br&gt;(external)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F8FA;strokeColor=#8C959F;dashed=1;fontColor=#24292F;" vertex="1" parent="1">
          <mxGeometry x="1570" y="145" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="splunk" value="Splunk SIEM&lt;br&gt;(HTTP Event Collector)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F8FA;strokeColor=#8C959F;dashed=1;fontColor=#24292F;" vertex="1" parent="1">
          <mxGeometry x="1570" y="730" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- EDGES: agent path -->
        <mxCell id="e1" value="1. trigger" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="eventbridge" target="lambda">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="2. read stock" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="lambda" target="rds">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="2. prices + notes" style="html=1;endArrow=block;endFill=1;strokeColor=#CF222E;fontSize=11;fontColor=#CF222E;labelBackgroundColor=#ffffff;exitX=0;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="lambda" target="market">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="3. propose purchase" style="html=1;endArrow=block;endFill=1;strokeColor=#01A88D;fontSize=11;fontColor=#017A66;labelBackgroundColor=#ffffff;exitX=1;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="lambda" target="bedrock">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="4. check call (before_tool_call)&lt;br&gt;&lt;b&gt;Proceed / Deny / Guide / Confirm&lt;/b&gt;" style="html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeColor=#C77700;strokeWidth=2;fontSize=11;fontColor=#9A5B00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="lambda" target="decider">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="5. purchase intent&lt;br&gt;(Proceed only)" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="lambda" target="sqs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_confirm" value="Confirm: Decider unsure" style="html=1;endArrow=block;endFill=1;strokeColor=#D29922;strokeWidth=2;dashed=1;fontSize=11;fontColor=#9A6700;fontStyle=1;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="decider" target="stepfn">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="660" y="370" />
              <mxPoint x="660" y="590" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- EDGES: control path -->
        <mxCell id="e7" value="6. pull intent" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sqs" target="gate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="load policy" style="html=1;endArrow=block;endFill=1;strokeColor=#7AA116;fontSize=11;labelBackgroundColor=#ffffff;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="thisrepo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="get credential&lt;br&gt;(APPROVED only)" style="html=1;endArrow=block;endFill=1;strokeColor=#DD344C;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.85;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="thisrepo" target="secrets">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="7a. APPROVED: pay merchant" style="html=1;endArrow=block;endFill=1;strokeColor=#2EA44F;strokeWidth=2;fontSize=11;fontColor=#1A7F37;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gate" target="payment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="7b. NEEDS APPROVAL" style="html=1;endArrow=block;endFill=1;strokeColor=#D29922;strokeWidth=2;fontSize=11;fontColor=#9A6700;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.85;exitDx=0;exitDy=0;" edge="1" parent="1" source="thisrepo" target="stepfn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="approve / reject" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="idc" target="stepfn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="sign in" style="html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="human" target="idc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- EDGES: logging -->
        <mxCell id="e14" value="8. every decision + reason&lt;br&gt;(including BLOCKED)" style="html=1;endArrow=block;endFill=1;strokeColor=#8250DF;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="thisrepo" target="cloudwatch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e15" value="guardrail verdicts + scores" style="html=1;endArrow=block;endFill=1;strokeColor=#8250DF;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="thisrepo_agent" target="cloudwatch">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="550" y="700" />
              <mxPoint x="1040" y="700" />
              <mxPoint x="1040" y="760" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e16" value="stream" style="html=1;endArrow=block;endFill=1;strokeColor=#8250DF;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cloudwatch" target="firehose">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17" value="9. alerts + search" style="html=1;endArrow=block;endFill=1;strokeColor=#8250DF;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="firehose" target="splunk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- NOTE -->
        <mxCell id="note" value="Reference architecture: how this would run in production on AWS. The agent, the Decider 2B guardrail and the Spend Gate are built in this repo; the AWS services around them show the environment they are designed for. Two controls, two jobs: the Decider guardrail runs in the agent's path and catches a &lt;b&gt;fooled&lt;/b&gt; agent (guessed values, injected instructions, mislabeled items). The Spend Gate is the trust boundary and stops a &lt;b&gt;compromised&lt;/b&gt; one: the agent's IAM role can only send to the queue, so its only path to the money is through the gate." style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#57606A;" vertex="1" parent="1">
          <mxGeometry x="200" y="855" width="1330" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
